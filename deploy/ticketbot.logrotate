# Installation:  cp deploy/ticketbot.logrotate /etc/logrotate.d/ticketbot
#
# Ohne Rotation war /var/log/ticketbot.log auf 23 MB angewachsen, weil im
# Debug-Modus der komplette Text jeder Nachricht mitgeschrieben wurde.

/var/log/ticketbot.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su www-data www-data
    create 0640 www-data www-data
}
